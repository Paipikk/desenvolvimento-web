# Variáveis das edge functions (supabase secrets set --env-file supabase/functions/.env)
# Chave pública do Datajud divulgada pelo CNJ em https://datajud-wiki.cnj.jus.br/api-publica/acesso
# O CNJ troca essa chave de tempos em tempos: basta atualizar aqui e rodar `supabase secrets set`.
DATAJUD_API_KEY=
# Chave da API da Anthropic (Claude) para gerar as mensagens. Sem ela, usa-se um texto-modelo.
ANTHROPIC_API_KEY=
# Opcional: modelo usado na geração (padrão claude-opus-5)
ANTHROPIC_MODEL=
# Mesmo valor guardado no Vault como andamento_cron_secret
CRON_SECRET=

# ---- E-mail (Resend: https://resend.com) ----
# Chave da API do Resend. Sem ela o botão "Enviar por e-mail" não aparece.
RESEND_API_KEY=
# Remetente. Deixe vazio para usar o remetente de teste do Resend (onboarding@resend.dev),
# que só entrega para o e-mail da SUA conta Resend. Em produção: um endereço do seu domínio verificado.
EMAIL_REMETENTE=
# MODO TESTE: se preenchido, todo e-mail vai para este endereço (e não para os clientes).
# Use o mesmo e-mail com que você criou a conta no Resend.
EMAIL_TESTE_DESTINO=
